# syntax=docker/dockerfile:1.7
FROM lmsysorg/sglang:v0.5.20@sha256:06e4f2ed21afde4ff513cda65070124e727ba23ccaeff7712b8c40e1097d611f AS build
COPY setup.py pyproject.toml MANIFEST.in README.md LICENSE kvcached_autopatch.pth /opt/kvcached-src/
COPY csrc /opt/kvcached-src/csrc
COPY kvcached /opt/kvcached-src/kvcached
COPY docker/install-wheel.sh /opt/kvcached-src/docker/install-wheel.sh
RUN bash /opt/kvcached-src/docker/install-wheel.sh

FROM lmsysorg/sglang:v0.5.20@sha256:06e4f2ed21afde4ff513cda65070124e727ba23ccaeff7712b8c40e1097d611f
COPY --from=build /tmp/wheels /tmp/wheels
RUN python3 -m pip install --no-index --find-links=/tmp/wheels /tmp/wheels/kvcached-*.whl && rm -rf /tmp/wheels
ENV ENABLE_KVCACHED=true KVCACHED_AUTOPATCH=1 KVCACHED_IPC_NAME=SGLANG
EXPOSE 8080 12346 30000 30001
ENTRYPOINT []
CMD ["bash"]

ARG SOURCE_REVISION=unknown
ARG SOURCE_URL=https://github.com/ovg-project/kvcached
LABEL org.opencontainers.image.source=$SOURCE_URL \
      org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.version="0.1.6" \
      org.opencontainers.image.base.name="lmsysorg/sglang:v0.5.20" \
      org.opencontainers.image.base.digest="sha256:06e4f2ed21afde4ff513cda65070124e727ba23ccaeff7712b8c40e1097d611f" \
      io.kvcached.engine="sglang" \
      io.kvcached.engine.version="0.5.20"
